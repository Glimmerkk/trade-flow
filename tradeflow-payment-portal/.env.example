# Generated automatically with `npm run setup` or `node setup.js`.
# Keep APP_SECRET private. Never change it once live data has been created.
APP_SECRET=REPLACE_WITH_A_64_CHARACTER_HEX_SECRET_GENERATED_BY_SETUP
PORT=3000
# Update this after deploying to a PUBLIC HTTPS domain. localhost works only on this computer.
PUBLIC_BASE_URL=http://localhost:3000
